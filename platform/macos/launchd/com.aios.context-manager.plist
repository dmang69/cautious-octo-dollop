<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aios.context-manager</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ai-runtime</string>
        <string>--config</string>
        <string>/etc/aios/config.toml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/aios/ai-runtime.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/aios/ai-runtime.error.log</string>

    <key>UserName</key>
    <string>_aios</string>

    <key>GroupName</key>
    <string>_aios</string>
</dict>
</plist>
