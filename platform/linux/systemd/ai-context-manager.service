[Unit]
Description=AI OS Context Manager Daemon
Documentation=https://github.com/dmang69/cautious-octo-dollop
After=network.target

[Service]
Type=simple
User=aios
Group=aios
ExecStart=/usr/local/bin/ai-runtime --config /etc/aios/config.toml
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-context-manager

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aios /var/log/aios

[Install]
WantedBy=multi-user.target
